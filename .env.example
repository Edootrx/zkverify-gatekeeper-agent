# Copy to .env on your host (or set as platform env vars). NEVER commit .env.
# From Dashboard -> My Agents -> (your agent) -> Rotate Secret. Shown ONCE.
AGENT_GAMES_HMAC_SECRET=
# Public port / path (register the FULL url, e.g. https://your-app.up.railway.app/agent)
PORT=8080
AGENT_PATH=/agent
# taskId field encoding for the circuit: bytes | sha256 | numeric
# Default "bytes". If Practice Mode reports proofs as invalid/mismatched,
# switch this and re-run practice — the platform's practice verdict is the test.
TASKID_ENCODING=bytes
# Optional Kurier submission (needs a mainnet Kurier API key). Default off.
KURIER_API_KEY=
SUBMIT_TO_KURIER=0
